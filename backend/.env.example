# Environment
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://shopup:shopup_password_123@localhost:5432/shopup
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopup
DB_USER=shopup
DB_PASSWORD=shopup_password_123

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_12345
JWT_REFRESH_EXPIRE=30d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# M-Pesa
MPESA_API_KEY=your_mpesa_api_key
MPESA_API_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORT_CODE=your_shortcode
MPESA_PASSKEY=your_passkey

# Email
SENDGRID_API_KEY=your_sendgrid_api_key
SENDER_EMAIL=noreply@shopup.ke
SENDER_NAME=ShopUp Kenya

# AWS S3 (for image uploads)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=shopup-kenya

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=your_session_secret_key_here

# API
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Logging
LOG_LEVEL=debug
