{
  "name": "shopup-backend",
  "version": "1.0.0",
  "description": "ShopUp Kenya E-Commerce Backend API",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "sequelize-cli db:migrate",
